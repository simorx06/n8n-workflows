# Public hostname where n8n is reachable (e.g. n8n.example.com)
N8N_HOST=

# Internal port n8n listens on (default: 5678)
N8N_PORT=

# Protocol for webhook URLs (https)
N8N_PROTOCOL=

# 32-byte hex key used to encrypt credentials and secrets
N8N_ENCRYPTION_KEY=

# Number of reverse-proxy hops in front of n8n (set to 1 when behind Caddy)
N8N_PROXY_HOPS=1

# Override the webhook URL (e.g. https://n8n.example.com/)
WEBHOOK_URL=

# Enable automatic pruning of old execution data (true / false)
EXECUTIONS_DATA_PRUNE=

# Max age of execution data in hours before pruning (default: 168)
EXECUTIONS_DATA_MAX_AGE=

# Timeout in seconds for the prune operation (default: 3600)
EXECUTIONS_DATA_PRUNE_TIMEOUT=

# Enable diagnostics / telemetry (true / false)
N8N_DIAGNOSTICS_ENABLED=

# Enable onboarding personalization (true / false)
N8N_PERSONALIZATION_ENABLED=

# Show version update notifications (true / false)
N8N_VERSION_NOTIFICATIONS_ENABLED=

# System timezone (e.g. Europe/London)
GENERIC_TIMEZONE=